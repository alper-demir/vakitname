{
  "expo": {
    "name": "Vakitname",
    "slug": "vakitname",
    "version": "0.3.0-rc.1",
    "scheme": "vakitname",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.alemdem.vakitname",
      "versionCode": 1,
      "icon": "./assets/icon/vakit-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/vakit-icon-foreground.png",
        "backgroundColor": "#06432F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Vakitname"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bulunduğunuz yerin namaz vakitlerini cihazınızda hesaplamak için konumunuza izin verin. Dilerseniz şehir seçebilirsiniz."
        }
      ],
      "expo-status-bar",
      "expo-localization",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/vakit_tone.wav"
          ],
          "color": "#628567"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/vakit-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E1324",
          "dark": {
            "backgroundColor": "#0E1324"
          }
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5365686-2c53-4aab-9277-c5989561eea5"
      }
    },
    "owner": "alemdem",
    "updates": {
      "url": "https://u.expo.dev/e5365686-2c53-4aab-9277-c5989561eea5"
    }
  }
}
