{
  "expo": {
    "name": "Vakit",
    "slug": "vakit",
    "version": "0.3.0-rc.1",
    "scheme": "vakit",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "icon": "./assets/icon/vakit-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/vakit-icon-foreground.png",
        "backgroundColor": "#06432F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Vakit"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bulunduğunuz yerin namaz vakitlerini cihazınızda hesaplamak için konumunuza izin verin. Dilerseniz şehir seçebilirsiniz."
        }
      ],
      "expo-status-bar",
      "expo-localization",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/vakit-tone.wav"
          ],
          "color": "#628567"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/vakit-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E1324",
          "dark": {
            "backgroundColor": "#0E1324"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
